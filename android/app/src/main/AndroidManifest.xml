<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.StreamX.Telegram">

        <activity
            android:name="com.music.streamx.extensions.telegram.ConfigActivity"
            android:label="StreamX Telegram"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:exported="true">
            <intent-filter>
                <action android:name="com.music.streamx.action.EXTENSION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="streamx.extension.api"
                android:value="1" />
            <meta-data
                android:name="streamx.extension.type"
                android:value="source" />
            <meta-data
                android:name="streamx.extension.authority"
                android:value="com.music.streamx.extensions.telegram.source" />
        </activity>

        <activity
            android:name="com.music.streamx.extensions.telegram.MainActivity"
            android:exported="false" />

        <activity
            android:name="com.music.streamx.extensions.telegram.SettingsActivity"
            android:label="Configure Telegram"
            android:exported="true" />

        <!--
          Exported content provider providing metadata and audio stream handles to the StreamX host app.
          Security justification:
          The provider must be exported (exported="true") so the external StreamX host process can discover
          and query it across package boundaries. Every IPC call is strictly validated at runtime
          in call() by CallerVerifier, which cryptographically verifies the calling package and
          its signing certificate SHA-256 fingerprint against an allowlist before returning any data.
        -->
        <provider
            android:name="com.music.streamx.extensions.telegram.StreamXProvider"
            android:authorities="com.music.streamx.extensions.telegram.source"
            android:exported="true" />

        <service
            android:name="com.music.streamx.extensions.telegram.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name="com.music.streamx.extensions.telegram.BackgroundWorkerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Long running background processing task similar to terminal operations." />
        </service>

    </application>

</manifest>
