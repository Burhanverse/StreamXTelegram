<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- StreamX Apple Music OLED Dark Theme -->
    <style name="Theme.StreamX.Telegram" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Palette Colors -->
        <item name="colorPrimary">#FFFFFF</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorPrimaryContainer">#27272A</item>
        <item name="colorOnPrimaryContainer">#FFFFFF</item>

        <item name="colorSecondary">#A1A1AA</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="colorSecondaryContainer">#1E1E22</item>
        <item name="colorOnSecondaryContainer">#FFFFFF</item>

        <item name="colorSurface">#0D0D0F</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorSurfaceVariant">#141417</item>
        <item name="colorOnSurfaceVariant">#A1A1AA</item>

        <item name="android:colorBackground">#000000</item>
        <item name="colorOnBackground">#FFFFFF</item>

        <item name="colorOutline">#27272A</item>
        <item name="colorOutlineVariant">#1E1E22</item>

        <!-- Bottom Sheet Dialog Style -->
        <item name="bottomSheetDialogTheme">@style/StreamX.BottomSheetDialogTheme</item>

        <!-- Edge-to-Edge System Bars -->
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="StreamX.BottomSheetDialogTheme" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/StreamX.BottomSheetModal</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#0A0A0C</item>
    </style>

    <style name="StreamX.BottomSheetModal" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">#0A0A0C</item>
        <item name="shapeAppearance">@style/StreamX.RoundedBottomSheetShape</item>
    </style>

    <style name="StreamX.RoundedBottomSheetShape" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
    </style>
</resources>
